# Canvas 数据库
CANVAS_POSTGRES_PASSWORD=replace-with-a-long-random-password
# 用于加密账号同步文档中的 API Key、令牌和密码，生产环境必须使用随机长密钥并持久保存。
DATA_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
APP_ORIGIN=http://localhost:3000
# 留空时根据 APP_ORIGIN 是否为 HTTPS 自动决定。
COOKIE_SECURE=
SESSION_TTL=168h

# Hajimi 身份桥（可选；两边必须填写同一条独立随机密钥）
HAJIMI_BASE_URL=http://host.docker.internal:8080
# 至少 32 个随机字符，不要复用 Hajimi 的 JWT_SECRET。
HAJIMI_SSO_CLIENT_SECRET=
HAJIMI_LOGIN_URL=http://localhost:8080/canvas-launch
